{
  "name": "geo-page",
  "description": "FastEdge HTTP app that shows the visitor's IP address, country and city",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && npx fastedge-build --input ./src/index.ts --output ./wasm/geo-page.wasm --tsconfig ./tsconfig.json",
    "test": "node ./fastedge-test/app.test.mjs",
    "preview": "./scripts/preview.sh",
    "deploy": "./scripts/deploy.sh"
  },
  "devDependencies": {
    "@gcoredev/fastedge-sdk-js": "^2.7.0",
    "@gcoredev/fastedge-test": "^0.2.6",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
