# Development placeholders for the Base44 sandbox (docker-compose.base44.yml).
#
# This file is listed FIRST in every service's `env_file:` chain, so the real
# values the platform delivers to /run/base44/app.env always take precedence.
# It is committed on purpose: it lets the stack boot with no credentials at all.

# A real Gcore permanent API token is only needed for an actual FastEdge
# deployment (docs/DEPLOYMENT.md). Locally the app talks to the control-plane
# mock from docker-compose.base44.yml, which accepts this placeholder key.
GCORE_API_KEY=test-gcore-api-key
